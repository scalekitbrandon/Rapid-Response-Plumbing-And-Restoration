// Cloudflare Workers static-assets deploy. With this file present,
// `wrangler deploy` serves dist/ as-is instead of auto-adding the Cloudflare
// adapter (the site is fully static and needs no Worker code).
// public/_redirects (old WordPress URLs) is honored by Workers static assets.
{
  "name": "rapid-response",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
