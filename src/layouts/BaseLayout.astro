---
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
  /** Overrides the canonical URL's path. Defaults to the current page's path. */
  canonicalPath?: string;
  /** Absolute URL to an image for Open Graph / Twitter Card previews. */
  ogImage?: string;
  /** true = keep this page out of search results (thank-you pages, etc.). */
  noindex?: boolean;
}

const { title, description = '', canonicalPath, ogImage, noindex = false } = Astro.props;

const canonicalURL = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const resolvedOgImage = new URL(ogImage ?? '/og-image.jpg', Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#05070d" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Preload the heading + body font files so they are ready at first paint (prevents headline reflow/CLS).
         If Google updates these file URLs, the preload just goes unused; the stylesheet below still works. -->
    <link rel="preload" as="font" type="font/woff2" crossorigin href="https://fonts.gstatic.com/s/saira/v23/memhYa2wxmKQyNkiV50dulWP7s95AqZ6zbvQfS2svGaA.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="https://fonts.gstatic.com/s/barlow/v13/7cHqv4kjgoGqM7E3t-4s51ostz0rdg.woff2" />
    <!-- Blocking on purpose: non-blocking fonts caused layout shift (CLS 0.145) as headings reflowed. -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:ital,wght@0,400;0,500;0,600;0,700;1,800&family=Saira:ital,wdth,wght@1,112.5,700;1,112.5,800;1,112.5,900&display=swap" />
    {description && <meta name="description" content={description} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalURL} />
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}

    <meta name="twitter:card" content={resolvedOgImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}
  </head>
  <body>
    <slot name="header" />
    <main>
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--color-bg);
    color: var(--color-fg);
    font-family: var(--font-body);
  }
  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-max);
    font-style: var(--heading-style);
    font-stretch: var(--heading-stretch);
    letter-spacing: var(--heading-tracking);
    margin: 0;
  }
  .container {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-4);
  }
</style>
