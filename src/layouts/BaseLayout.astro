---
import Analytics from '../components/Analytics.astro';
import SchemaGraph from '../components/SchemaGraph.astro';
import type { PageSchema } from '../lib/schema';
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
  /** Overrides the canonical URL's path. Defaults to the current page's path. */
  canonicalPath?: string;
  /** Absolute URL to an image for Open Graph / Twitter Card previews. */
  ogImage?: string;
  /** true = keep this page out of search results (thank-you pages, etc.). */
  noindex?: boolean;
  /**
   * JSON-LD for this page (see src/lib/schema.ts). Defaults to `home` on "/"
   * and a plain `page` elsewhere — pass the real kind plus breadcrumbs/faqs.
   */
  schema?: PageSchema;
}

const { title, description = '', canonicalPath, ogImage, noindex = false, schema } = Astro.props;
const pageSchema: PageSchema = schema ?? { kind: Astro.url.pathname === '/' ? 'home' : 'page' };

const canonicalURL = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const resolvedOgImage = new URL(ogImage ?? '/og-image.jpg', Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Analytics />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#05070d" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex" />}
    <!-- Fonts are self-hosted (public/fonts, @font-face below) so nothing render-blocks on Google.
         Preload the heading + body files so they are ready at first paint (prevents headline reflow/CLS). -->
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/saira-italic-var.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/barlow-400.woff2" />
    <!-- Button weight: without it the hero CTAs shift when Barlow 700 swaps in. -->
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/barlow-700.woff2" />
    {description && <meta name="description" content={description} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalURL} />
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}

    <meta name="twitter:card" content={resolvedOgImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}
    {!noindex && <SchemaGraph page={pageSchema} title={title} description={description} />}
  </head>
  <body>
    <slot name="header" />
    <main>
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>

<style is:global>
  /* Latin subsets of Barlow + Saira from Google Fonts, self-hosted. */
  @font-face {
    font-family: 'Barlow';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('/fonts/barlow-400.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Barlow';
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url('/fonts/barlow-500.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Barlow';
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url('/fonts/barlow-600.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Barlow';
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url('/fonts/barlow-700.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Barlow';
    font-style: italic;
    font-weight: 800;
    font-display: swap;
    src: url('/fonts/barlow-800-italic.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  /* Variable file (weight 700-900 used), served at the 112.5% width Google Fonts set for it. */
  @font-face {
    font-family: 'Saira';
    font-style: italic;
    font-weight: 700 900;
    font-stretch: 112.5%;
    font-display: swap;
    src: url('/fonts/saira-italic-var.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  * {
    box-sizing: border-box;
  }
  /* <picture> only picks the AVIF/WebP file; let the <img> inside lay out as if it stood alone. */
  picture {
    display: contents;
  }
  /* Fire/water section backgrounds (see src/lib/fireWaterBg.ts): WebP, upgraded to AVIF where the browser takes it. */
  [style*='--fw-webp'] {
    --fw-bg: var(--fw-webp);
    --fw-bg-mobile: var(--fw-webp-m);
  }
  @supports (background-image: image-set(url('x.avif') type('image/avif'))) {
    [style*='--fw-webp'] {
      --fw-bg: var(--fw-avif);
      --fw-bg-mobile: var(--fw-avif-m);
    }
  }
  body {
    margin: 0;
    background: var(--color-bg);
    color: var(--color-fg);
    font-family: var(--font-body);
  }
  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-max);
    font-style: var(--heading-style);
    font-stretch: var(--heading-stretch);
    letter-spacing: var(--heading-tracking);
    margin: 0;
  }
  .container {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-4);
  }
</style>
