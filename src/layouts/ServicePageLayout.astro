---
/*
  Shared template for every service page (plumbing now, restoration next).
  Built to rank and convert:
  - Keyword in title, H1, first paragraph, H2s and URL; long-tail variants as H3s (IssueGrid)
  - Above the fold: H1, 24/7 promise, tap-to-call, form CTA and the Google rating
  - Useful content: emergency checklist, process, long-form body and FAQ (with FAQPage schema)
  - Proof: trust strip, real job photo, service-matched reviews
  - Internal links: breadcrumbs, related services, service area chips
  - JSON-LD: Service (with provider and areaServed), BreadcrumbList, FAQPage (in FAQ.astro)
*/
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InnerHero from '../components/InnerHero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import IssueGrid from '../components/IssueGrid.astro';
import UrgentSteps from '../components/UrgentSteps.astro';
import ServiceSplit from '../components/ServiceSplit.astro';
import Process from '../components/Process.astro';
import Reviews from '../components/Reviews.astro';
import FAQ from '../components/FAQ.astro';
import RelatedServices from '../components/RelatedServices.astro';
import AreaLinks from '../components/AreaLinks.astro';
import ProseSection from '../components/ProseSection.astro';
import InspectionForm from '../components/InspectionForm.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';
import { primaryNav, utilityLinks, business, serviceAreas } from '../data/site';

interface Props {
  entry: CollectionEntry<'plumbing'> | CollectionEntry<'restoration'>;
  category: { label: string; href: string };
  providerType: string; // schema.org type for the provider, e.g. "Plumber"
}

const { entry, category, providerType } = Astro.props;
const isPlumbing = entry.collection === 'plumbing';
// Per-category defaults: the cross-sell link under the split checklist, the hero call-card title and the form lead.
const splitLink = entry.data.split.link ?? (isPlumbing
  ? { label: 'Water damage restoration', href: '/water-damage-restoration/' }
  : { label: 'Plumbing services', href: '/plumbing/' });
const nowTitle = isPlumbing ? 'Plumbing or water emergency?' : 'Property damage emergency?';
const formLead = isPlumbing
  ? 'Tell us what is going on and where. We will call you right back. If water is actively leaking, shut it off if you can and call now.'
  : 'Tell us what happened and where. We will call you right back to schedule your free inspection. If damage is still spreading, call now.';
const d = entry.data;
const { Content } = await entry.render();

const site = Astro.site ?? new URL(Astro.url.origin);
const pageUrl = new URL(Astro.url.pathname, site).toString();
const crumbs = [
  { label: 'Home', href: '/' },
  { label: category.label, href: category.href },
  { label: d.navLabel },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: d.h1,
  serviceType: d.navLabel,
  description: d.description,
  url: pageUrl,
  areaServed: serviceAreas.map((a) => ({ '@type': 'City', name: `${a.name}, CA` })),
  provider: {
    '@type': providerType,
    name: business.name,
    telephone: '+1-855-477-2743',
    url: new URL('/', site).toString(),
    openingHours: 'Mo-Su 00:00-23:59',
    areaServed: serviceAreas.map((a) => ({ '@type': 'City', name: `${a.name}, CA` })),
  },
};
---

<BaseLayout title={d.title} description={d.description}>
  <Header
    slot="header"
    businessName={business.name}
    nav={primaryNav}
    utilityLinks={utilityLinks}
    phoneDisplay={business.phoneDisplay}
    phoneHref={business.phoneHref}
  />

  <InnerHero crumbs={crumbs} eyebrow={d.eyebrow} h1={d.h1} h1Accent={d.h1Accent} sub={d.heroSub} bullets={d.heroBullets} nowTitle={nowTitle} />
  <TrustStrip />
  <IssueGrid heading={d.issuesHeading} intro={d.issuesIntro} issues={d.issues} />
  {d.urgent && <UrgentSteps heading={d.urgent.heading} intro={d.urgent.intro} steps={d.urgent.steps} />}
  <ServiceSplit
    heading={d.split.heading}
    accent={d.split.accent}
    text={d.split.text}
    points={d.split.points}
    image={d.split.image}
    imageAlt={d.split.imageAlt}
    linkLabel={splitLink.label}
    linkHref={splitLink.href}
  />
  <Process
    eyebrow="How It Works"
    headlineLead={d.processHeading}
    headlineAccent={d.processAccent}
    body="What happens from the moment you call."
    steps={d.process}
  />

  <ProseSection heading={d.bodyHeading}>
    <Content />
  </ProseSection>

  <Reviews
    googleReviewsUrl={business.googleReviewsUrl}
    writeReviewUrl={business.reviewUrl}
    headingLead="What Customers Say About"
    headingAccent="Our Emergency Response"
    tags={d.reviewTags}
    limit={4}
  />
  <FAQ headingLead={d.navLabel} headingAccent="FAQs" intro={`Common questions about ${d.navLabel.toLowerCase()} service in Victorville and the High Desert.`} items={d.faqs} />
  <RelatedServices hrefs={d.related} />
  <AreaLinks heading={d.areasHeading} intro="Fast 24/7 response across Southern California's High Desert. Choose your city for local service details." service={d.navLabel} />
  <InspectionForm
    eyebrow="24/7 Service"
    headingLead={d.formHeading}
    headingAccent={d.formAccent}
    lead={formLead}
    formName={`${d.navLabel} form`}
    submitLabel="Request Service Now"
    defaultDamageType={d.formDamageType}
  />

  <Footer slot="footer" />

  <BreadcrumbSchema
    items={[
      { label: 'Home', url: new URL('/', site).toString() },
      { label: category.label, url: new URL(category.href, site).toString() },
      { label: d.navLabel, url: pageUrl },
    ]}
  />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
</BaseLayout>
