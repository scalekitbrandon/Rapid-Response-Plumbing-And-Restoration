---
/*
  Las Vegas service page template (/las-vegas/<service>/). One page per service so each can rank for
  "[service] Las Vegas" without being a thin doorway page:
  - Nevada-specific title, H1, hero, problem grid, FAQs and long-form body (from the `vegas` collection)
  - The California base page's generic sections (emergency checklist, split, process) are reused only if
    they contain no California-specific claims (towns, "High Desert", "1 hour"). Otherwise they are left out
    or replaced with a generic version.
  - No "1 hour or less" promise anywhere in Nevada copy.
  - Links: breadcrumbs to the Las Vegas hub, related Las Vegas services, every Las Vegas service, and the
    matching California page.
  - JSON-LD: Service (areaServed Las Vegas, NV), BreadcrumbList, FAQPage (in FAQ.astro).
*/
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InnerHero from '../components/InnerHero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import IssueGrid from '../components/IssueGrid.astro';
import UrgentSteps from '../components/UrgentSteps.astro';
import ServiceSplit from '../components/ServiceSplit.astro';
import Process from '../components/Process.astro';
import ProseSection from '../components/ProseSection.astro';
import Reviews from '../components/Reviews.astro';
import FAQ from '../components/FAQ.astro';
import RelatedServices from '../components/RelatedServices.astro';
import InspectionForm from '../components/InspectionForm.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';
import { primaryNav, utilityLinks, business, plumbingServices, restorationServices, vegasHref } from '../data/site';

interface Props {
  entry: CollectionEntry<'vegas'>;
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await entry.render();

// Find the California base service this page localizes.
const baseEntries = [...(await getCollection('plumbing')), ...(await getCollection('restoration'))];
const base = baseEntries.find((e) =>
  e.collection === 'plumbing' ? `/plumbing/${e.slug}/` === d.service : `/${e.slug}/` === d.service,
);
if (!base) throw new Error(`Vegas page ${entry.slug}: no base service found for ${d.service}`);
const b = base.data;
const isPlumbing = base.collection === 'plumbing';

// Reuse base sections only when they carry no California-specific claims.
const caPattern = /High Desert|Victorville|Hesperia|Apple Valley|Victor Valley|Inland Empire|California|1 hour|one hour/i;
const clean = (v: unknown) => !caPattern.test(JSON.stringify(v));
const urgent = b.urgent && clean(b.urgent) ? b.urgent : undefined;
const split = clean({ ...b.split, image: undefined }) ? b.split : undefined;
const process = clean(b.process)
  ? b.process
  : [
      { title: 'Call 24/7', text: 'Call 855-47-RAPID any time. Tell us what happened and we will walk you through the first steps.' },
      { title: 'Assess the Problem', text: 'We find the source and explain what we found before any work starts.' },
      { title: 'Fix & Mitigate', text: 'We repair the source and stop the damage from spreading.' },
      { title: 'Dry, Restore & Document', text: 'We dry and restore what was affected and document everything for your insurance claim.' },
    ];

const site = Astro.site ?? new URL(Astro.url.origin);
const pageUrl = new URL(Astro.url.pathname, site).toString();
const hubUrl = new URL('/las-vegas/', site).toString();

const faqs = [
  ...d.faqs,
  {
    q: `How fast can you get to my property in Las Vegas?`,
    a: 'We are on call 24/7 for the Las Vegas Valley. Call 855-47-RAPID and we will give you an arrival time right away and walk you through what to do until we get there.',
  },
  {
    q: 'Do you work with my insurance company?',
    a: 'Yes. We work with all major insurance carriers and document the damage with photos and moisture readings to keep your claim organized and moving.',
  },
];

const allVegas = [...plumbingServices, ...restorationServices].filter((s) => s.href !== d.service);

const vegasTrust = [
  { value: '24/7', label: 'Emergency Response', text: 'Nights, weekends and holidays across the Las Vegas Valley.', tone: 'fire' as const },
  { value: 'ONE', label: 'Call for Everything', text: 'We fix the plumbing and restore the damage it caused.', tone: 'water' as const },
  { value: 'FREE', label: 'Inspections', text: 'Know what you are dealing with before work starts.', tone: 'chrome' as const },
  { value: 'CLAIMS', label: 'Insurance Help', text: 'We work with all major insurance carriers and document the damage for your claim.', tone: 'fire' as const },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: d.h1,
  serviceType: b.navLabel,
  description: d.description,
  url: pageUrl,
  areaServed: { '@type': 'City', name: 'Las Vegas, NV' },
  provider: {
    '@type': isPlumbing ? 'Plumber' : 'HomeAndConstructionBusiness',
    name: business.name,
    telephone: '+1-855-477-2743',
    url: new URL('/', site).toString(),
    openingHours: 'Mo-Su 00:00-23:59',
  },
};
---

<BaseLayout title={d.title} description={d.description}>
  <Header
    slot="header"
    businessName={business.name}
    nav={primaryNav}
    utilityLinks={utilityLinks}
    phoneDisplay={business.phoneDisplay}
    phoneHref={business.phoneHref}
  />

  <InnerHero
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Las Vegas, NV', href: '/las-vegas/' },
      { label: b.navLabel },
    ]}
    eyebrow={`${b.navLabel} · Las Vegas, NV`}
    h1={d.h1}
    h1Accent={d.h1Accent}
    sub={d.heroSub}
    bullets={['On call 24/7 across the Las Vegas Valley', 'Plumbing repair and restoration in one call', 'We work with all major insurance carriers']}
    nowTitle="Emergency in Las Vegas?"
    nowText="Call 24/7. We will give you an arrival time right away."
  />
  <TrustStrip items={vegasTrust} />
  <IssueGrid heading={d.issuesHeading} intro={d.issuesIntro} issues={d.issues} />
  {urgent && <UrgentSteps heading={urgent.heading} intro={urgent.intro} steps={urgent.steps} />}
  {split && (
    <ServiceSplit
      heading={split.heading}
      accent={split.accent}
      text={split.text}
      points={split.points}
      image={split.image}
      imageAlt={split.imageAlt}
      linkLabel={isPlumbing ? 'Water damage restoration in Las Vegas' : 'Plumbing services in Las Vegas'}
      linkHref={isPlumbing ? '/las-vegas/water-damage-restoration/' : '/las-vegas/emergency-plumber/'}
    />
  )}
  <Process
    eyebrow="How It Works"
    headlineLead={b.processHeading}
    headlineAccent={b.processAccent}
    body="What happens from the moment you call."
    steps={process}
  />

  <ProseSection heading={`${b.navLabel} in Las Vegas, Nevada`} sideText="Call 24/7 in Las Vegas. We will give you an arrival time right away.">
    <Content />
  </ProseSection>

  <Reviews
    googleReviewsUrl={business.googleReviewsUrl}
    writeReviewUrl={business.reviewUrl}
    headingLead="What Customers Say About"
    headingAccent="Rapid Response"
    tags={b.reviewTags}
    limit={4}
  />
  <FAQ headingLead={`${b.navLabel} Las Vegas`} headingAccent="FAQs" intro={`Common questions about ${b.navLabel.toLowerCase()} in Las Vegas, NV.`} items={faqs} />
  <RelatedServices heading="Related Services in Las Vegas" hrefs={b.related} hrefFor={vegasHref} />

  <section class="all-vegas" aria-labelledby="all-vegas-heading">
    <div class="container">
      <h2 id="all-vegas-heading">More Services in Las Vegas, NV</h2>
      <ul>
        {allVegas.map((s) => (
          <li><a href={vegasHref(s.href)}>{s.label} in Las Vegas</a></li>
        ))}
      </ul>
      <p class="cross">
        <a href="/las-vegas/">All plumbing &amp; restoration in Las Vegas</a> ·
        <a href={d.service}>{b.navLabel} in California</a>
      </p>
    </div>
  </section>

  <InspectionForm
    eyebrow="24/7 in Las Vegas"
    headingLead="Request Help in"
    headingAccent="Las Vegas Today"
    lead="Tell us what happened at your Las Vegas property. We will call you right back. If water is actively leaking, shut it off if you can and call now."
    formName={`Las Vegas ${b.navLabel} form`}
    defaultCity="Las Vegas"
    defaultDamageType={b.formDamageType}
    fastResponse={false}
    areaLabel="the Las Vegas Valley"
  />

  <Footer slot="footer" />

  <BreadcrumbSchema
    items={[
      { label: 'Home', url: new URL('/', site).toString() },
      { label: 'Las Vegas, NV', url: hubUrl },
      { label: b.navLabel, url: pageUrl },
    ]}
  />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
</BaseLayout>

<style>
  .all-vegas {
    background: #fff;
    padding-block: var(--space-7);
  }
  .all-vegas h2 {
    margin-bottom: var(--space-4);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    color: var(--color-fg);
  }
  .all-vegas ul {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .all-vegas a {
    color: var(--color-water-dark);
    font-weight: 600;
  }
  .cross {
    margin: var(--space-5) 0 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    color: #6b7487;
  }
  @media (max-width: 900px) {
    .all-vegas ul { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 520px) {
    .all-vegas ul { grid-template-columns: 1fr; }
  }
</style>
