---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CoreServices from '../components/CoreServices.astro';
import TrustStrip from '../components/TrustStrip.astro';
import RealWork from '../components/RealWork.astro';
import InsuranceCarriers from '../components/InsuranceCarriers.astro';
import Process from '../components/Process.astro';
import Reviews from '../components/Reviews.astro';
import ServiceAreas from '../components/ServiceAreas.astro';
import FAQ from '../components/FAQ.astro';
import InspectionForm from '../components/InspectionForm.astro';
import Footer from '../components/Footer.astro';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';
import { primaryNav, utilityLinks, business, serviceAreas } from '../data/site';

const site = Astro.site ?? new URL(Astro.url.origin);
---

<BaseLayout
  title="Plumbing & Water Damage Restoration in Victorville, CA | Rapid Response"
  description="Emergency plumbing, water damage, flood, mold and fire restoration across Victorville, Apple Valley, Hesperia and the High Desert. Call 855-47-RAPID, 24/7."
>
  <Header
    slot="header"
    businessName={business.name}
    nav={primaryNav}
    utilityLinks={utilityLinks}
    phoneDisplay={business.phoneDisplay}
    phoneHref={business.phoneHref}
  />

  <Hero phoneDisplay={business.phoneDisplay} phoneHref={business.phoneHref} />
  <CoreServices phoneDisplay={business.phoneDisplay} phoneHref={business.phoneHref} />
  <TrustStrip />
  <RealWork />
  <InsuranceCarriers phoneDisplay={business.phoneDisplay} phoneHref={business.phoneHref} />
  <Process phoneDisplay={business.phoneDisplay} phoneHref={business.phoneHref} />
  <Reviews googleReviewsUrl={business.googleReviewsUrl} writeReviewUrl={business.reviewUrl} />
  <ServiceAreas phoneDisplay={business.phoneDisplay} phoneHref={business.phoneHref} />
  <FAQ phoneDisplay={business.phoneDisplay} phoneHref={business.phoneHref} />
  <InspectionForm />

  <Footer slot="footer" />

  {/* Service-area business: no street address on purpose (none is public on the Google profile). */}
  <LocalBusinessSchema
    businessType="Plumber"
    name={business.name}
    url={new URL('/', site).toString()}
    phone="+1-855-477-2743"
    areaServed={serviceAreas.map((a) => `${a.name}, CA`)}
    logo={new URL('/icon-192.png', site).toString()}
    image={new URL('/og-image.jpg', site).toString()}
    sameAs={[business.googleReviewsUrl]}
    openingHours="Mo-Su 00:00-23:59"
  />
</BaseLayout>
