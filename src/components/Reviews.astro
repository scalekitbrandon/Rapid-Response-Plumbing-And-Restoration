---
/*
  Reviews: a summary (Google rating + count) next to a grid of real Google review cards.
  Data comes from src/data/reviews.ts. Only real, word-for-word Google reviews go there.
  While no reviews are loaded, it shows a "Read our reviews on Google" panel instead of cards.
*/
import { reviews, reviewSummary } from '../data/reviews';

interface Props {
  googleReviewsUrl: string;
  writeReviewUrl?: string;
}

const { googleReviewsUrl, writeReviewUrl } = Astro.props;
const hasReviews = reviews.length > 0;
const shown = reviews.slice(0, 8);
const hasSummary = reviewSummary.rating !== null || reviewSummary.count !== null;
---

<section class:list={["reviews", { "is-empty": !hasReviews }]} aria-labelledby="reviews-heading">
  <div class="container">
    <div class="head">
      <div>
        <span class="eyebrow">Reviews</span>
        <h2 id="reviews-heading">
          What High Desert Property Owners <span class="accent">Say About Us</span>
        </h2>
      </div>

      {hasSummary && (
      <div class="summary">
        <svg class="g" viewBox="0 0 48 48" width="40" height="40" aria-hidden="true"><path fill="#4285F4" d="M45.1 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h11.8c-.5 2.8-2.1 5.1-4.4 6.7v5.5h7.1c4.2-3.9 6.6-9.6 6.6-16.2z"/><path fill="#34A853" d="M24 46c5.9 0 10.9-2 14.5-5.3l-7.1-5.5c-2 1.3-4.5 2.1-7.4 2.1-5.7 0-10.6-3.8-12.3-9H4.4v5.7C8 41.1 15.4 46 24 46z"/><path fill="#FBBC05" d="M11.7 28.3c-.4-1.3-.7-2.8-.7-4.3s.3-3 .7-4.3V14H4.4C2.9 17 2 20.4 2 24s.9 7 2.4 10l7.3-5.7z"/><path fill="#EA4335" d="M24 10.7c3.2 0 6.1 1.1 8.4 3.3l6.3-6.3C34.9 4.2 29.9 2 24 2 15.4 2 8 6.9 4.4 14l7.3 5.7c1.7-5.2 6.6-9 12.3-9z"/></svg>
        <div>
          {reviewSummary.rating !== null ? (
            <p class="score">
              <strong>{reviewSummary.rating.toFixed(1)}</strong>
              <span class="stars" aria-label={`${reviewSummary.rating} out of 5 stars`}>★★★★★</span>
            </p>
          ) : (
            <p class="score"><strong class="label">Google Reviews</strong></p>
          )}
          <p class="count">
            {reviewSummary.count !== null ? `Based on ${reviewSummary.count} Google reviews` : 'Rated on Google'}
          </p>
        </div>
      </div>
      )}
    </div>

    {hasReviews ? (
      <ul class="grid">
        {shown.map((r) => (
          <li class="card">
            <span class="stars" aria-label={`${r.rating} out of 5 stars`}>{'★'.repeat(r.rating)}</span>
            <blockquote>{r.text}</blockquote>
            <p class="who">
              <strong>{r.name}</strong>
              {r.when && <span> · {r.when}</span>}
            </p>
            {r.service && <span class="tag">{r.service}</span>}
          </li>
        ))}
      </ul>
    ) : (
      <div class="empty">
        <svg class="g" viewBox="0 0 48 48" width="48" height="48" aria-hidden="true"><path fill="#4285F4" d="M45.1 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h11.8c-.5 2.8-2.1 5.1-4.4 6.7v5.5h7.1c4.2-3.9 6.6-9.6 6.6-16.2z"/><path fill="#34A853" d="M24 46c5.9 0 10.9-2 14.5-5.3l-7.1-5.5c-2 1.3-4.5 2.1-7.4 2.1-5.7 0-10.6-3.8-12.3-9H4.4v5.7C8 41.1 15.4 46 24 46z"/><path fill="#FBBC05" d="M11.7 28.3c-.4-1.3-.7-2.8-.7-4.3s.3-3 .7-4.3V14H4.4C2.9 17 2 20.4 2 24s.9 7 2.4 10l7.3-5.7z"/><path fill="#EA4335" d="M24 10.7c3.2 0 6.1 1.1 8.4 3.3l6.3-6.3C34.9 4.2 29.9 2 24 2 15.4 2 8 6.9 4.4 14l7.3 5.7c1.7-5.2 6.6-9 12.3-9z"/></svg>
        <p>
          Read what homeowners, landlords and businesses across Victorville, Apple Valley, Hesperia and
          the High Desert say about working with Rapid Response.
        </p>
      </div>
    )}

    <div class="actions">
      <a class="btn btn-primary" href={googleReviewsUrl} target="_blank" rel="noopener">Read Our Google Reviews</a>
      {writeReviewUrl && (
        <a class="btn btn-ghost" href={writeReviewUrl} target="_blank" rel="noopener">Leave a Review</a>
      )}
    </div>
  </div>
</section>

<style>
  .reviews {
    background: var(--color-muted);
    padding-block: var(--space-8);
  }
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: var(--space-6);
  }
  .eyebrow {
    display: inline-block;
    margin-bottom: var(--space-3);
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-water);
  }
  h2 {
    max-width: 18ch;
    font-size: clamp(1.8rem, 3.2vw, 2.7rem);
    line-height: 1.15;
    color: var(--color-fg);
  }
  h2 .accent {
    color: var(--color-fire);
  }

  .summary {
    flex: none;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: 0 8px 24px rgba(10, 26, 63, 0.06);
  }
  .summary p {
    margin: 0;
  }
  .score {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .score strong {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 900;
    font-size: 1.8rem;
    line-height: 1;
  }
  .stars {
    color: #f5b301;
    letter-spacing: 2px;
    font-size: 1.15rem;
  }
  .score .label {
    font-size: 1.25rem;
  }
  .count {
    font-weight: 600;
    color: #5a6478;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    background: #fff;
    border-radius: var(--radius-lg);
    border-top: 4px solid var(--color-fire);
    box-shadow: 0 8px 24px rgba(10, 26, 63, 0.06);
  }
  .card:nth-child(even) {
    border-top-color: var(--color-water);
  }
  blockquote {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: #2a3245;
  }
  .who {
    margin: auto 0 0;
    color: #5a6478;
  }
  .who strong {
    color: var(--color-fg);
  }
  .tag {
    align-self: flex-start;
    padding: 3px 10px;
    border-radius: var(--radius-sm);
    background: var(--color-navy-2);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .is-empty .head {
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: var(--space-4);
  }
  .is-empty h2 {
    max-width: none;
    text-wrap: balance;
  }
  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
  }
  .empty p {
    max-width: 60ch;
    margin: 0 auto;
    font-size: 1.15rem;
    line-height: 1.6;
    color: #3a4356;
  }

  .actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 56px;
    padding: 0 30px;
    border-radius: var(--radius-pill);
    font-weight: var(--font-weight-button);
    font-size: 1.1rem;
    text-decoration: none;
    transition: background 0.15s, transform 0.15s, color 0.15s;
  }
  .btn:hover {
    transform: translateY(-2px);
  }
  .btn-primary {
    background: var(--color-water);
    color: #fff;
    box-shadow: var(--glow-water);
  }
  .btn-primary:hover {
    background: var(--color-water-dark);
  }
  .btn-ghost {
    border: 2px solid var(--color-navy-2);
    color: var(--color-navy-2);
  }
  .btn-ghost:hover {
    background: var(--color-navy-2);
    color: #fff;
  }

  @media (max-width: 1000px) {
    .head { flex-direction: column; align-items: flex-start; }
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .reviews { padding-block: var(--space-7); }
    .grid { grid-template-columns: 1fr; }
    .card:nth-child(n + 5) { display: none; }
    .empty { padding: var(--space-5) var(--space-4); }
    .btn { width: 100%; justify-content: center; }
  }
</style>
