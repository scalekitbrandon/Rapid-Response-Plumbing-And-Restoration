---
/*
  Photo + copy split for service pages, used for the "plumbing + restoration under one roof" differentiator.
  A real job photo on the left; heading, text and a checklist on the right (light gray section).
*/
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  heading: string;
  accent: string;
  text: string;
  points: string[];
  image: ImageMetadata;
  imageAlt: string;
  linkLabel?: string;
  linkHref?: string;
}

const { heading, accent, text, points, image, imageAlt, linkLabel, linkHref } = Astro.props;
---

<section class="split" aria-labelledby="split-heading">
  <div class="container layout">
    <div class="media">
      <Image src={image} alt={imageAlt} widths={[480, 720, 960]} sizes="(max-width: 900px) 100vw, 560px" format="webp" quality={74} loading="lazy" />
      <span class="badge">Real Rapid Response job</span>
    </div>
    <div class="copy">
      <h2 id="split-heading">{heading} <span class="accent">{accent}</span></h2>
      <p>{text}</p>
      <ul>
        {points.map((pt) => (
          <li>
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="currentColor" /><path d="M7 12.5l3.2 3.2L17 9" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
            {pt}
          </li>
        ))}
      </ul>
      {linkLabel && linkHref && <a class="more" href={linkHref}>{linkLabel} <span aria-hidden="true">→</span></a>}
    </div>
  </div>
</section>

<style>
  .split {
    background: var(--color-muted);
    padding-block: var(--space-8);
  }
  .layout {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: var(--space-7);
    align-items: center;
  }
  .media {
    position: relative;
  }
  .media :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: 0 24px 48px rgba(10, 26, 63, 0.2);
  }
  .badge {
    position: absolute;
    left: var(--space-3);
    bottom: var(--space-3);
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: rgba(5, 7, 13, 0.8);
    color: #fff;
    font-weight: 700;
    font-size: 0.85rem;
  }
  h2 {
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    line-height: 1.15;
    color: var(--color-fg);
    text-wrap: balance;
  }
  h2 .accent {
    color: var(--color-fire);
  }
  .copy > p {
    margin: var(--space-3) 0 var(--space-4);
    font-size: 1.12rem;
    line-height: 1.65;
    color: #3a4356;
  }
  ul {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.45;
    color: var(--color-fg);
  }
  li svg {
    flex: none;
    color: var(--color-water);
  }
  .more {
    display: inline-block;
    margin-top: var(--space-4);
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fire-dark); /* 4.5:1+ on the light gray section */
    text-decoration: none;
  }
  .more:hover {
    color: var(--color-water);
  }

  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; gap: var(--space-5); }
  }
  @media (max-width: 600px) {
    .split { padding-block: var(--space-7); }
  }
</style>
