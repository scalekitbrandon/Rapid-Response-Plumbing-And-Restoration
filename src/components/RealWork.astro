---
/*
  Real Work: a headline row (two-tone H2 + intro on the left, CTA on the right) over a 4-column grid
  of real job photos, each tagged with its service and a short caption.
  Photos come from the client's current site (rapidresponsefloodrestoration.com). No stock.
  TODO(client): confirm each caption matches what happened on that job.
*/
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ceiling from '../assets/work/ceiling-collapse-water-leak.jpg';
import fire from '../assets/work/structure-fire-response.jpg';
import drying from '../assets/work/structural-drying-air-movers.jpg';
import moldWall from '../assets/work/mold-inside-wall-cavity.jpg';
import extraction from '../assets/work/carpet-water-extraction.jpg';
import commercial from '../assets/work/commercial-flood-extraction.jpg';
import drywall from '../assets/work/removing-wet-drywall.jpg';
import moldPpe from '../assets/work/mold-remediation-ppe.jpg';

type Tone = 'water' | 'fire' | 'mold' | 'navy';

interface Photo {
  src: ImageMetadata;
  alt: string;
  tag: string;
  caption: string;
  tone: Tone;
}

interface Props {
  headlineLead?: string;
  headlineAccent?: string;
  body?: string;
  ctaLabel?: string;
  ctaHref?: string;
  photos?: Photo[];
}

const {
  headlineLead = 'Real Damage. Real Equipment.',
  headlineAccent = 'Real Restoration Work.',
  body = 'Every photo here comes from a Rapid Response job in the High Desert. No stock photos, just the losses we show up to and the work we do.',
  ctaLabel = 'Request Free Inspection',
  ctaHref = '/#request-inspection',
  photos = [
    { src: ceiling, alt: 'Kitchen ceiling collapsed after a water leak, insulation on the counters', tag: 'Water Damage', caption: 'Ceiling collapse after a hidden leak', tone: 'water' },
    { src: fire, alt: 'Structure fire with heavy black smoke behind a chain-link fence', tag: 'Fire & Smoke', caption: 'On scene at a structure fire', tone: 'fire' },
    { src: drying, alt: 'Gutted room with drywall removed and blue air movers drying the framing', tag: 'Structural Drying', caption: 'Air movers drying out exposed framing', tone: 'water' },
    { src: moldWall, alt: 'Mold growth on studs and drywall inside an opened wall cavity', tag: 'Mold', caption: 'Mold found behind the drywall', tone: 'mold' },
    { src: extraction, alt: 'Technician using a water extraction tool on soaked carpet', tag: 'Water Extraction', caption: 'Pulling water out of saturated carpet', tone: 'water' },
    { src: commercial, alt: 'Large commercial floor with standing water and extraction hoses', tag: 'Commercial', caption: 'Commercial flood cleanup', tone: 'navy' },
    { src: drywall, alt: 'Technician cutting out water-damaged drywall at floor level', tag: 'Demolition', caption: 'Removing wet drywall to stop the spread', tone: 'fire' },
    { src: moldPpe, alt: 'Technician in full protective suit working inside a containment area', tag: 'Mold', caption: 'Full protective gear for mold removal', tone: 'mold' },
  ],
} = Astro.props;
---

<section class="real-work" aria-labelledby="real-work-heading">
  <div class="container">
    <div class="head">
      <div>
        <h2 id="real-work-heading">
          {headlineLead} <span class="accent">{headlineAccent}</span>
        </h2>
        <p>{body}</p>
      </div>
      <a class="cta" href={ctaHref}>{ctaLabel}</a>
    </div>

    <ul class="grid">
      {photos.map((p, i) => (
        <li class={`tile tone-${p.tone}`}>
          <Image
            src={p.src}
            alt={p.alt}
            widths={[320, 480, 640]}
            sizes="(max-width: 600px) 50vw, (max-width: 1000px) 33vw, 300px"
            format="webp"
            quality={72}
            loading={i < 4 ? 'eager' : 'lazy'}
          />
          <div class="overlay">
            <span class="tag">{p.tag}</span>
            <span class="caption">{p.caption}</span>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .real-work {
    background: var(--color-muted);
    padding-block: var(--space-8);
  }

  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    margin-bottom: var(--space-6);
  }
  h2 {
    font-size: clamp(1.8rem, 3.2vw, 2.7rem);
    line-height: 1.15;
    color: var(--color-fg);
  }
  h2 .accent {
    color: var(--color-fire);
  }
  .head p {
    margin: var(--space-3) 0 0;
    max-width: 60ch;
    font-size: 1.15rem;
    line-height: 1.6;
    color: #3a4356;
  }
  .cta {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: 56px;
    padding: 0 32px;
    border-radius: var(--radius-pill);
    background: var(--color-water);
    color: #fff;
    font-weight: var(--font-weight-button);
    font-size: 1.1rem;
    text-decoration: none;
    box-shadow: var(--glow-water);
    transition: background 0.15s, transform 0.15s;
  }
  .cta:hover {
    background: var(--color-water-dark);
    transform: translateY(-2px);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tile {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-navy);
  }
  .tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s;
  }
  .tile:hover :global(img) {
    transform: scale(1.05);
  }
  .overlay {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: 48px var(--space-3) var(--space-3);
    background: linear-gradient(180deg, transparent 0%, rgba(5, 7, 13, 0.88) 70%);
    color: #fff;
  }
  .tag {
    padding: 3px 10px;
    border-radius: var(--radius-sm);
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 800;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .tone-water .tag { background: var(--color-water); }
  .tone-fire .tag { background: var(--color-fire); }
  .tone-mold .tag { background: var(--color-mold); }
  .tone-navy .tag { background: var(--color-navy-2); }
  .caption {
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.3;
  }

  @media (max-width: 1000px) {
    .head { flex-direction: column; align-items: flex-start; gap: var(--space-4); }
    .grid { grid-template-columns: repeat(3, 1fr); }
    .tile:nth-child(n + 7) { display: none; }
  }
  @media (max-width: 600px) {
    .real-work { padding-block: var(--space-7); }
    .grid { grid-template-columns: repeat(2, 1fr); gap: var(--space-2); }
    .tile:nth-child(n + 7) { display: block; }
    .overlay { padding: 36px 10px 10px; }
    .caption { font-size: 0.9rem; }
    .tag { font-size: 0.66rem; letter-spacing: 0.04em; padding: 2px 7px; }
    .cta { align-self: stretch; justify-content: center; }
  }
</style>
