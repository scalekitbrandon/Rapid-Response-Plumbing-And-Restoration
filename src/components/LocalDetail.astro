---
/*
  LocalDetail: the town-specific core of a "service in town" page.
  - homes: what the housing stock is and what fails in it (cards)
  - neighborhoods: parts of town with a note on what we see there (definition list)
  Content comes from the `local` collection. Only facts true of this town belong here.
*/
interface Props {
  town: string;
  homes?: { heading: string; intro: string; items: { title: string; text: string }[] };
  neighborhoods?: { heading: string; intro: string; list: { name: string; note: string }[] };
}

const { town, homes, neighborhoods } = Astro.props;
---

{homes && (
  <section class="homes" aria-labelledby="homes-heading">
    <div class="container">
      <div class="head">
        <span class="eyebrow">Homes &amp; Pipes in {town}</span>
        <h2 id="homes-heading">{homes.heading}</h2>
        <p>{homes.intro}</p>
      </div>
      <ul class="cards">
        {homes.items.map((h) => (
          <li class="card">
            <h3>{h.title}</h3>
            <p>{h.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

{neighborhoods && (
  <section class="hoods" aria-labelledby="hoods-heading">
    <div class="container">
      <div class="head">
        <span class="eyebrow">Where We Work in {town}</span>
        <h2 id="hoods-heading">{neighborhoods.heading}</h2>
        <p>{neighborhoods.intro}</p>
      </div>
      <dl class="list">
        {neighborhoods.list.map((n) => (
          <div class="item">
            <dt>{n.name}</dt>
            <dd>{n.note}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
)}

<style>
  .homes {
    background: #f2f8ff;
    padding-block: var(--space-8);
  }
  .hoods {
    background: #fff;
    padding-block: var(--space-8);
  }
  .head {
    max-width: 760px;
    margin-bottom: var(--space-6);
  }
  .eyebrow {
    display: block;
    margin-bottom: var(--space-2);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-water-dark);
  }
  h2 {
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    line-height: 1.15;
    color: var(--color-fg);
    text-wrap: balance;
  }
  .head p {
    margin: var(--space-3) 0 0;
    font-size: 1.15rem;
    line-height: 1.6;
    color: #3a4356;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    padding: var(--space-5) var(--space-4);
    border: 1px solid var(--color-border);
    border-top: 4px solid var(--color-water);
    border-radius: var(--radius-lg);
    background: #fff;
  }
  .card h3 {
    margin: 0 0 var(--space-2);
    font-size: 1.2rem;
    line-height: 1.3;
    color: var(--color-fg);
  }
  .card p {
    margin: 0;
    line-height: 1.6;
    color: #3a4356;
  }
  .list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4) var(--space-6);
    margin: 0;
  }
  .item {
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }
  dt {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-fg);
  }
  dd {
    margin: var(--space-1) 0 0;
    line-height: 1.6;
    color: #3a4356;
  }
  @media (max-width: 720px) {
    .list { grid-template-columns: 1fr; }
  }
</style>
