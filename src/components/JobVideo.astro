---
/*
  Job Video: a two-tone H2, intro and step list beside a vertical (Shorts) YouTube video.
  The video is a click-to-load facade: only the thumbnail loads with the page, and the
  youtube-nocookie iframe is swapped in on tap, so the embed costs nothing for Lighthouse.
  VideoObject JSON-LD comes from the page's `schema.video` (src/lib/schema.ts).
*/
interface Props {
  youtubeId: string;
  title: string;
  headingLead: string;
  headingAccent: string;
  body: string;
  steps?: string[];
}

const { youtubeId, title, headingLead, headingAccent, body, steps = [] } = Astro.props;
// hqdefault always exists. For a Short it is 480x360 with the 9:16 frame centered, so object-fit: cover crops it exactly.
const thumb = `https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg`;
const embed = `https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=1&playsinline=1&rel=0`;
---

<section class="job-video" aria-labelledby="job-video-heading">
  <div class="container inner">
    <div class="copy">
      <h2 id="job-video-heading">
        {headingLead} <span class="accent">{headingAccent}</span>
      </h2>
      <p>{body}</p>
      {steps.length > 0 && (
        <ol>
          {steps.map((s) => <li>{s}</li>)}
        </ol>
      )}
      <a class="cta" href="/#request-inspection">Request Free Inspection</a>
    </div>

    <div class="frame">
      <button type="button" class="play" data-embed={embed} data-title={title} aria-label={`Play video: ${title}`}>
        <img src={thumb} alt="" width="480" height="360" loading="lazy" decoding="async" />
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 68 48" width="68" height="48"><path d="M66.5 7.7c-.8-2.9-2.5-5.4-5.4-6.2C55.8.1 34 0 34 0S12.2.1 6.9 1.6c-3 .7-4.6 3.2-5.4 6.1C.1 13 0 24 0 24s.1 11 1.5 16.3c.8 2.9 2.5 5.4 5.4 6.2C12.2 47.9 34 48 34 48s21.8-.1 27.1-1.5c2.9-.8 4.6-3.3 5.4-6.2C67.9 35 68 24 68 24s-.1-11-1.5-16.3z" fill="#f00"/><path d="M45 24 27 14v20" fill="#fff"/></svg>
        </span>
      </button>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.job-video .play').forEach((btn) => {
    btn.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = btn.dataset.embed!;
      iframe.title = btn.dataset.title!;
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      btn.replaceWith(iframe);
    });
  });
</script>

<style>
  .job-video {
    background: var(--color-muted);
    padding-block: var(--space-8);
  }
  .inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-8);
  }
  h2 {
    font-size: clamp(1.8rem, 3.2vw, 2.7rem);
    line-height: 1.15;
    color: var(--color-fg);
  }
  h2 .accent {
    color: var(--color-fire);
  }
  .copy p {
    margin: var(--space-3) 0 0;
    max-width: 60ch;
    font-size: 1.15rem;
    line-height: 1.6;
    color: #3a4356;
  }
  ol {
    margin: var(--space-4) 0 0;
    padding-left: 1.4em;
    display: grid;
    gap: var(--space-2);
    font-size: 1.1rem;
    line-height: 1.5;
    color: var(--color-fg);
  }
  ol li::marker {
    font-weight: 800;
    color: var(--color-water-ui);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 56px;
    margin-top: var(--space-6);
    padding: 0 32px;
    border-radius: var(--radius-pill);
    background: var(--color-water-ui);
    color: #fff;
    font-weight: var(--font-weight-button);
    font-size: 1.1rem;
    text-decoration: none;
    box-shadow: var(--glow-water);
    transition: background 0.15s, transform 0.15s;
  }
  .cta:hover {
    background: var(--color-water-dark);
    transform: translateY(-2px);
  }

  .frame {
    width: min(340px, 100%);
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-navy);
    box-shadow: 0 18px 40px rgba(5, 7, 13, 0.25);
  }
  .play {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .play img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .icon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0.9;
    transition: opacity 0.15s, transform 0.15s;
  }
  .play:hover .icon,
  .play:focus-visible .icon {
    opacity: 1;
    transform: scale(1.08);
  }
  .frame :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  @media (max-width: 800px) {
    .job-video { padding-block: var(--space-7); }
    .inner { grid-template-columns: 1fr; gap: var(--space-6); }
    .frame { justify-self: center; width: min(320px, 100%); }
    .cta { width: 100%; justify-content: center; }
  }
</style>
