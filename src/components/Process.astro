---
/*
  Process: 4 numbered steps on the fire/water brand background (a "pop" section).
  Step names and descriptions come from the client's current homepage ("Our Emergency Restoration Process").
*/
import { fireWaterBg } from '../lib/fireWaterBg';

interface Step {
  title: string;
  text: string;
}

interface Props {
  eyebrow?: string;
  headlineLead?: string;
  headlineAccent?: string;
  body?: string;
  steps?: Step[];
  phoneDisplay?: string;
  phoneHref?: string;
}

const {
  eyebrow = 'How It Works',
  headlineLead = 'Our Emergency',
  headlineAccent = 'Restoration Process',
  body = 'From the first call to the final repair plan, here is what happens when Rapid Response shows up.',
  steps = [
    { title: 'Emergency Assessment', text: 'We evaluate the visible damage, identify immediate concerns, and find the fastest way to stabilize the loss.' },
    { title: 'Containment & Removal', text: 'Standing water, damaged contents, unsalvageable materials and contaminated areas are handled so cleanup can move forward safely.' },
    { title: 'Drying, Cleanup & Stabilization', text: 'Drying and cleanup move the structure toward a stable condition and reduce the spread of secondary damage.' },
    { title: 'Restoration Planning', text: 'With the immediate damage handled, your property is ready for repairs, rebuild planning and final recovery.' },
  ],
  phoneDisplay = '855-47-RAPID',
  phoneHref = 'tel:+18554772743',
} = Astro.props;

const bgVars = await fireWaterBg();
---

<section class="process" style={bgVars} aria-labelledby="process-heading">
  <div class="overlay" aria-hidden="true"></div>
  <div class="container inner">
    <div class="head">
      <span class="eyebrow">{eyebrow}</span>
      <h2 id="process-heading">
        {headlineLead} <span class="accent">{headlineAccent}</span>
      </h2>
      <p>{body}</p>
    </div>

    <ol class="steps">
      {steps.map((s, i) => (
        <li class="step">
          <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>

    <div class="cta-row">
      <a class="call" href={phoneHref}>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24 11.4 11.4 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2z"/></svg>
        Start Step 1: {phoneDisplay}
      </a>
    </div>
  </div>
</section>

<style>
  .process {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-8);
    background: var(--color-black) var(--fw-bg) center / cover no-repeat;
    color: #fff;
  }
  .overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(5, 7, 13, 0.82) 0%, rgba(5, 7, 13, 0.6) 45%, rgba(5, 7, 13, 0.85) 100%);
  }
  .inner {
    position: relative;
  }

  .head {
    max-width: 760px;
    margin: 0 auto var(--space-7);
    text-align: center;
  }
  .eyebrow {
    display: inline-block;
    margin-bottom: var(--space-3);
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-flame);
  }
  h2 {
    font-size: clamp(1.9rem, 3.4vw, 2.9rem);
    line-height: 1.12;
    text-wrap: balance;
  }
  h2 .accent {
    color: var(--color-water);
    text-shadow: var(--glow-water);
  }
  .head p {
    margin: var(--space-3) 0 0;
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--color-chrome);
  }

  .steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }
  /* Fire-to-water rail behind the step numbers */
  .steps::before {
    content: '';
    position: absolute;
    top: 34px;
    left: 12%;
    right: 12%;
    height: 3px;
    background: var(--gradient-fire-water);
    opacity: 0.8;
  }
  .step {
    position: relative;
    padding: 0 var(--space-4) var(--space-5);
    padding-top: 0;
    text-align: center;
  }
  .num {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 70px;
    height: 70px;
    margin-bottom: var(--space-4);
    border-radius: 50%;
    background: var(--color-black);
    border: 3px solid var(--color-chrome);
    font-family: var(--font-heading);
    font-style: italic;
    font-stretch: var(--heading-stretch);
    font-weight: 900;
    font-size: 1.6rem;
    box-shadow: var(--glow-water);
  }
  .step:nth-child(1) .num,
  .step:nth-child(2) .num {
    border-color: var(--color-fire);
    box-shadow: var(--glow-fire);
  }
  .step:nth-child(3) .num,
  .step:nth-child(4) .num {
    border-color: var(--color-water);
  }
  h3 {
    font-size: 1.3rem;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .step p {
    margin: var(--space-2) 0 0;
    font-size: 1.02rem;
    line-height: 1.55;
    color: #d9dde5;
  }

  .cta-row {
    display: flex;
    justify-content: center;
    margin-top: var(--space-5);
  }
  .call {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 60px;
    padding: 0 34px;
    border-radius: var(--radius-pill);
    background: var(--color-fire);
    color: #fff;
    font-family: var(--font-heading);
    font-style: italic;
    font-stretch: var(--heading-stretch);
    font-weight: 800;
    font-size: 1.2rem;
    text-decoration: none;
    box-shadow: var(--glow-fire);
    transition: background 0.15s, transform 0.15s;
  }
  .call:hover {
    background: var(--color-fire-dark);
    transform: translateY(-2px);
  }

  @media (max-width: 1000px) {
    .steps { grid-template-columns: repeat(2, 1fr); row-gap: var(--space-6); }
    .steps::before { display: none; }
  }
  @media (max-width: 600px) {
    .process { background-image: var(--fw-bg-mobile); padding-block: var(--space-7); }
    .steps { grid-template-columns: 1fr; row-gap: var(--space-5); }
    .step {
      display: grid;
      grid-template-columns: 56px 1fr;
      column-gap: var(--space-3);
      text-align: left;
      padding: 0;
    }
    .num { grid-row: span 2; width: 56px; height: 56px; font-size: 1.25rem; margin: 0; }
    .call { width: 100%; justify-content: center; font-size: 1.05rem; }
  }
</style>
