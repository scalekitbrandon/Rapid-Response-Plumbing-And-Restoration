---
/*
  Site footer: a black base with the fire/water line along the top.
  Columns: brand + contact, Restoration links, Plumbing links, Service Areas. The bottom bar has the copyright,
  legal links and the required ScaleKit credit.
  NAP: name + phone only. The Google profile is a service-area business with no public address,
  so no address is shown. TODO(client): add the CSLB license # once provided.
*/
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { business, restorationServices, plumbingServices, serviceAreas } from '../data/site';
import { reviewSummary } from '../data/reviews';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="fire-water-line" aria-hidden="true"></div>
  <div class="container top">
    <div class="brand">
      <a href="/" class="logo" aria-label={`${business.name} home`}>
        <Image src={logo} alt={business.name} width={110} height={110} densities={[1, 2]} loading="lazy" />
      </a>
      <p class="tagline">{business.tagline}</p>
      <a class="phone" href={business.phoneHref}>{business.phoneDisplay}</a>
      <p class="phone-digits">{business.phoneDigits}</p>
      <ul class="meta">
        <li>Open 24 hours, 7 days a week</li>
        <li>Serving the High Desert, Inland Empire &amp; Las Vegas</li>
      </ul>
      {reviewSummary.rating !== null && (
        <a class="rating" href={business.googleReviewsUrl} target="_blank" rel="noopener">
          <span class="stars" aria-hidden="true">★★★★★</span>
          {reviewSummary.rating.toFixed(1)} on Google
        </a>
      )}
    </div>

    <nav class="col" aria-label="Restoration services">
      <p class="heading">Restoration</p>
      <ul>
        {restorationServices.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
      </ul>
    </nav>

    <nav class="col" aria-label="Plumbing services">
      <p class="heading">Plumbing</p>
      <ul>
        {plumbingServices.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
      </ul>
    </nav>

    <nav class="col" aria-label="Service areas">
      <p class="heading">Service Areas</p>
      <ul class="areas">
        {serviceAreas.map((a) => <li><a href={`/${a.slug}/`}>{a.name}, {a.state}</a></li>)}
      </ul>
    </nav>
  </div>

  <div class="bottom">
    <div class="container bottom-inner">
      <p class="copy">&copy; {year} {business.name}. All rights reserved.</p>
      <ul class="legal">
        <li><a href="/about-us/">About Us</a></li>
        <li><a href="/contact-us/">Contact</a></li>
        <li><a href="/privacy-policy/">Privacy Policy</a></li>
      </ul>
    </div>
    {/* Standing rule for every site built from the starter kit. Do not remove, reword or make this optional. */}
    <p class="built-by">Website and Local SEO by <a href="https://scalekit.io" target="_blank" rel="noopener noreferrer">ScaleKit.io</a></p>
  </div>
</footer>

<!-- Sticky tap-to-call bar on phones (every page renders the footer). -->
<div class="mobile-call" role="region" aria-label="Call or request service">
  <a class="mc-call" href={business.phoneHref}>
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24 11.4 11.4 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2z"/></svg>
    Call 24/7
  </a>
  <a class="mc-form" href="#request-inspection">Request Service</a>
</div>

<script>
  // Pages without the inspection form (privacy, 404, thank-you) send the button to the contact page instead.
  if (!document.getElementById('request-inspection')) {
    document.querySelector<HTMLAnchorElement>('.mc-form')?.setAttribute('href', '/contact-us/');
  }
</script>

<style>
  .site-footer {
    background: var(--color-black);
    color: #cfd4dd;
  }
  .fire-water-line {
    height: 3px;
    background: var(--gradient-fire-water);
  }
  .top {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1fr;
    gap: var(--space-6);
    padding-block: var(--space-7);
  }

  .logo {
    display: inline-block;
  }
  .logo :global(img) {
    display: block;
    width: 110px;
    height: 110px;
    clip-path: circle(57% at 50% 50%);
  }
  .tagline {
    margin: var(--space-3) 0 var(--space-2);
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 800;
    color: #fff;
  }
  .phone {
    display: inline-block;
    font-family: var(--font-heading);
    font-style: italic;
    font-stretch: var(--heading-stretch);
    font-weight: 900;
    font-size: 1.8rem;
    color: var(--color-fire);
    text-decoration: none;
    text-shadow: var(--glow-fire);
  }
  .phone:hover {
    color: #fff;
  }
  .phone-digits {
    margin: 2px 0 0;
    font-weight: 600;
    color: var(--color-chrome);
  }
  .meta {
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 4px;
    font-size: 0.95rem;
  }
  .rating {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: var(--space-3);
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(201, 206, 214, 0.3);
    color: #fff;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .rating .stars {
    color: #f5b301;
    letter-spacing: 1px;
  }

  .heading {
    margin: 0 0 var(--space-3);
    padding-left: 10px;
    border-left: 3px solid var(--color-fire);
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
  }
  .col:nth-of-type(2) .heading { border-left-color: var(--color-water); }
  .col:nth-of-type(3) .heading { border-left-color: var(--color-flame); }
  .col ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
  }
  .col a {
    color: #cfd4dd;
    text-decoration: none;
    font-size: 0.98rem;
  }
  .col .areas {
    grid-template-columns: 1fr 1fr;
    column-gap: var(--space-3);
  }
  .col a:hover {
    color: var(--color-water);
  }

  .bottom {
    border-top: 1px solid #1a2238;
    padding-block: var(--space-4);
  }
  .bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .copy {
    margin: 0;
    font-size: 0.88rem;
  }
  .legal {
    display: flex;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.88rem;
  }
  .legal a {
    color: #cfd4dd;
    text-decoration: none;
  }
  .legal a:hover {
    color: #fff;
  }
  .built-by {
    margin: var(--space-3) 0 0;
    text-align: center;
    font-size: 0.82rem;
    color: #8d95a3;
  }
  .built-by a {
    color: inherit;
  }

  .mobile-call {
    display: none;
  }

  @media (max-width: 1000px) {
    .top { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 700px) {
    .mobile-call {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 60;
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 8px;
      padding: 8px 10px calc(8px + env(safe-area-inset-bottom));
      background: rgba(5, 7, 13, 0.96);
      border-top: 2px solid var(--color-fire);
      box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.35);
    }
    .mobile-call a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 50px;
      border-radius: var(--radius-pill);
      color: #fff;
      font-weight: 800;
      text-decoration: none;
    }
    .mc-call {
      background: var(--color-fire);
      font-family: var(--font-heading);
      font-style: italic;
      font-size: 1.1rem;
    }
    .mc-form {
      background: var(--color-water-ui);
    }
    :global(body) {
      padding-bottom: calc(70px + env(safe-area-inset-bottom));
    }
  }
  @media (max-width: 600px) {
    .top { gap: var(--space-5) var(--space-4); padding-block: var(--space-6); }
    .brand { grid-column: 1 / -1; }
    .col:last-child { grid-column: 1 / -1; }
  
    .bottom-inner { flex-direction: column; align-items: flex-start; }
    .built-by { text-align: left; padding-inline: var(--space-4); }
  }
</style>
