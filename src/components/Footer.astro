---
interface LinkGroup {
  heading: string;
  links: { label: string; href: string }[];
}

interface Props {
  logoText?: string;
  groups?: LinkGroup[];
  /** NAP block — omit any field that isn't confirmed yet rather than guessing. */
  phone?: string;
  email?: string;
  address?: string;
}

const { logoText = 'Logo', groups = [], phone, email, address } = Astro.props;
const year = new Date().getFullYear();
const hasNap = Boolean(phone || email || address);
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      {logoText}
      {hasNap && (
        <ul class="footer-nap">
          {address && <li>{address}</li>}
          {phone && <li><a href={`tel:${phone.replace(/[^\d+]/g, '')}`}>{phone}</a></li>}
          {email && <li><a href={`mailto:${email}`}>{email}</a></li>}
        </ul>
      )}
    </div>
    <div class="footer-groups">
      {groups.map((group) => (
        <div class="footer-group">
          <h4>{group.heading}</h4>
          <ul>
            {group.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="footer-copyright">&copy; {year} {logoText}. All rights reserved.</p>
    {/* Standing rule for every site built from this starter kit — do not
        remove or make optional. See astro-dept SKILL.md Universal Standards. */}
    <p class="built-by">Website and Local SEO by <a href="https://scalekit.io" target="_blank" rel="noopener noreferrer">ScaleKit.io</a></p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-6);
    background: var(--color-muted);
  }
  .footer-nap {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 0.85rem;
    opacity: 0.75;
  }
  .footer-nap a {
    color: inherit;
    text-decoration: none;
  }
  .footer-groups {
    display: flex;
    gap: var(--space-6);
    margin-block: var(--space-4);
  }
  .footer-group h4 {
    font-weight: var(--font-weight-button);
    margin-bottom: var(--space-2);
  }
  .footer-group ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .footer-group a {
    color: var(--color-fg);
    text-decoration: none;
  }
  .footer-copyright {
    font-size: 0.85rem;
    color: var(--color-fg);
    opacity: 0.6;
  }
  .built-by {
    font-size: 0.8rem;
    color: var(--color-fg);
    opacity: 0.5;
    margin-top: var(--space-2);
  }
  .built-by a {
    color: inherit;
  }
</style>
