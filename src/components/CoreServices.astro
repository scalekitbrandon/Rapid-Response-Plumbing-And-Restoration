---
import { areaList } from '../data/site';
/*
  Core Services: an intro row (two-tone headline + copy on the left, van photo on the right),
  then a 3-column grid of icon + big two-line title + "View More". The last cell is the call button.
  Layout was inspired by a reference screenshot (structure only). Colors, fonts and copy are Rapid Response's.
*/
import { Image } from 'astro:assets';
import van from '../assets/van-wrap.png';

type IconName = 'water' | 'fire' | 'mold' | 'plumbing' | 'commercial';

interface Service {
  icon: IconName;
  line1: string;
  line2: string;
  href: string;
}

interface Props {
  headlineLead?: string;
  headlineAccent?: string;
  body?: string;
  services?: Service[];
  phoneDisplay?: string;
  phoneHref?: string;
}

const {
  headlineLead = 'Rapid Response is',
  headlineAccent = "the High Desert's 24/7 plumbing and restoration team.",
  body = `From burst pipes and slab leaks to flooded rooms, fire, smoke and mold, our crews help homes and businesses across ${areaList}.`,
  services = [
    { icon: 'water', line1: 'Water', line2: 'Damage', href: '/water-damage-restoration/' },
    { icon: 'fire', line1: 'Fire & Smoke', line2: 'Damage', href: '/fire-smoke-damage-restoration/' },
    { icon: 'mold', line1: 'Mold', line2: 'Remediation', href: '/mold-remediation/' },
    { icon: 'plumbing', line1: 'Plumbing', line2: 'Services', href: '/plumbing/' },
    { icon: 'commercial', line1: 'Commercial', line2: 'Restoration', href: '/commercial-property-restoration/' },
  ],
  phoneDisplay = '855-47-RAPID',
  phoneHref = 'tel:+18554772743',
} = Astro.props;
---

<section class="core-services" aria-labelledby="core-services-heading">
  <div class="container">
    <div class="intro">
      <div class="intro-copy">
        <h2 id="core-services-heading">
          {headlineLead} <span class="accent">{headlineAccent}</span>
        </h2>
        <p>{body}</p>
      </div>
      <div class="intro-media">
        <Image
          src={van}
          alt="Rapid Response Plumbing & Restoration service van"
          widths={[480, 720, 960]}
          sizes="(max-width: 900px) 100vw, 560px"
          format="webp"
        />
      </div>
    </div>

    <ul class="grid">
      {services.map((s) => (
        <li>
          <a class={`service service-${s.icon}`} href={s.href}>
            <span class="icon" aria-hidden="true">
              {s.icon === 'water' && (
                <svg viewBox="0 0 48 48"><path d="M24 4C24 4 9 21 9 31a15 15 0 0 0 30 0C39 21 24 4 24 4z" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round" /></svg>
              )}
              {s.icon === 'fire' && (
                <svg viewBox="0 0 48 48"><path d="M24 4c2 8 12 12 12 24a12 12 0 0 1-24 0c0-6 3-10 6-13 0 5 2 8 5 9-2-7 1-14 1-20z" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round" /><path d="M24 44a6 6 0 0 1-6-6c0-4 4-6 5-10 3 3 7 6 7 10a6 6 0 0 1-6 6z" fill="currentColor" /></svg>
              )}
              {s.icon === 'mold' && (
                <svg viewBox="0 0 48 48"><circle cx="20" cy="22" r="6" fill="none" stroke="currentColor" stroke-width="4" /><circle cx="36" cy="10" r="5" fill="currentColor" /><circle cx="35" cy="34" r="5" fill="currentColor" /><circle cx="12" cy="38" r="4" fill="none" stroke="currentColor" stroke-width="3.5" /><circle cx="8" cy="10" r="3" fill="currentColor" /><circle cx="25" cy="38" r="2.5" fill="currentColor" /><circle cx="42" cy="22" r="2.5" fill="currentColor" /><circle cx="6" cy="24" r="2" fill="currentColor" /></svg>
              )}
              {s.icon === 'plumbing' && (
                <svg viewBox="0 0 48 48"><path d="M4 10h16v8h12a8 8 0 0 1 8 8v6h-8v-6H20v2H4z" fill="currentColor" /><path d="M36 37c0 3-2 6-4 6s-4-3-4-6 4-7 4-7 4 4 4 7z" fill="currentColor" /></svg>
              )}
              {s.icon === 'commercial' && (
                <svg viewBox="0 0 48 48"><path d="M8 44V8h20v36M28 18h12v26M4 44h40" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round" /><path d="M14 15h3M19 15h3M14 22h3M19 22h3M14 29h3M19 29h3M33 26h3M33 33h3" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" /></svg>
              )}
            </span>
            <span class="text">
              <span class="title"><span>{s.line1}</span><span>{s.line2}</span></span>
              <span class="more">View More</span>
            </span>
          </a>
        </li>
      ))}
      <li class="cta-cell">
        <a class="call-btn" href={phoneHref}>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24 11.4 11.4 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2z"/></svg>
          {phoneDisplay}
        </a>
        <span class="cta-note">24/7 · Homes &amp; businesses</span>
      </li>
    </ul>
  </div>
</section>

<style>
  .core-services {
    background: #fff;
    color: var(--color-fg);
    padding-block: var(--space-8);
  }

  /* Intro row */
  .intro {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: center;
    gap: var(--space-7);
  }
  h2 {
    font-size: clamp(1.8rem, 3.2vw, 2.7rem);
    line-height: 1.18;
    color: var(--color-fg);
  }
  h2 .accent {
    color: var(--color-fire);
  }
  .intro-copy p {
    margin: var(--space-4) 0 0;
    max-width: 58ch;
    font-size: 1.15rem;
    line-height: 1.6;
    color: #3a4356;
  }
  .intro-media :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: 0 24px 48px rgba(10, 26, 63, 0.22);
  }

  /* Service grid */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-7) var(--space-5);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }
  .service {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    color: var(--color-fg);
    text-decoration: none;
  }
  .icon {
    flex: none;
    width: 72px;
    height: 72px;
    margin-top: 6px;
    transition: transform 0.2s;
  }
  .icon svg {
    width: 100%;
    height: 100%;
  }
  .service-water .icon,
  .service-plumbing .icon { color: var(--color-water); }
  .service-fire .icon { color: var(--color-fire); }
  .service-mold .icon { color: var(--color-mold); }
  .service-commercial .icon { color: var(--color-navy-2); }

  .title {
    display: block;
    font-family: var(--font-heading);
    font-style: italic;
    font-stretch: var(--heading-stretch);
    font-weight: 900;
    font-size: clamp(1.6rem, 2.3vw, 2.2rem);
    line-height: 1.04;
    text-transform: uppercase;
  }
  .title > span {
    display: block;
    white-space: nowrap;
  }
  .more {
    display: inline-block;
    margin-top: var(--space-3);
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-fire);
  }
  .service:hover .icon { transform: scale(1.08) rotate(-4deg); }
  .service:hover .more { color: var(--color-water); }
  .service:focus-visible {
    outline: 3px solid var(--color-water);
    outline-offset: 6px;
    border-radius: var(--radius-md);
  }

  .cta-cell {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: var(--space-2);
  }
  .call-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 64px;
    padding: 0 40px;
    border-radius: var(--radius-md);
    background: var(--color-fire);
    color: #fff;
    font-family: var(--font-heading);
    font-style: italic;
    font-stretch: var(--heading-stretch);
    font-weight: 800;
    font-size: 1.35rem;
    text-decoration: none;
    box-shadow: var(--glow-fire);
    transition: background 0.15s, transform 0.15s;
  }
  .call-btn:hover {
    background: var(--color-fire-dark);
    transform: translateY(-2px);
  }
  .cta-note {
    padding-left: 4px;
    font-weight: 600;
    color: #5a6478;
  }

  @media (max-width: 1000px) {
    .intro { grid-template-columns: 1fr; gap: var(--space-5); }
    .grid { grid-template-columns: repeat(2, 1fr); gap: var(--space-6) var(--space-4); }
  }
  @media (max-width: 600px) {
    .core-services { padding-block: var(--space-7); }
    .grid { grid-template-columns: 1fr; gap: var(--space-5); margin-top: var(--space-7); }
    .icon { width: 56px; height: 56px; }
    .cta-cell { align-items: stretch; }
    .call-btn { justify-content: center; }
    .cta-note { text-align: center; }
  }
</style>
