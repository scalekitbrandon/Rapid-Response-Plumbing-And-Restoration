---
/*
  Inner-page hero (service and town pages). Breadcrumbs, eyebrow, an H1 with an accent phrase, a subhead,
  3 trust bullets and 2 CTAs on the left. A "call now" card on the right. Uses the fire/water brand background.
*/
import { fireWaterImages } from '../lib/fireWaterBg';
import { business } from '../data/site';
import { reviewSummary } from '../data/reviews';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  crumbs: Crumb[];
  eyebrow: string;
  h1: string;
  h1Accent: string;
  sub: string;
  bullets: string[];
  ctaLabel?: string;
  ctaHref?: string;
  nowTitle?: string;
  nowText?: string;
}

const {
  crumbs,
  eyebrow,
  h1,
  h1Accent,
  sub,
  bullets,
  ctaLabel = 'Request Service',
  ctaHref = '#request-inspection',
  nowTitle = 'Plumbing or water emergency?',
  nowText = 'Call 24/7. A crew heads your way in 1 hour or less.',
} = Astro.props;

// Split the H1 so the accent phrase gets its own color, keeping one plain-text H1 for SEO.
const at = h1.indexOf(h1Accent);
const before = at >= 0 ? h1.slice(0, at) : h1;
const after = at >= 0 ? h1.slice(at + h1Accent.length) : '';
const bgImg = await fireWaterImages();
---

<section class="inner-hero">
  <img
    class="bg-img"
    src={bgImg.desktop}
    srcset={`${bgImg.mobile} 900w, ${bgImg.desktop} 1920w`}
    sizes="100vw"
    alt=""
    fetchpriority="high"
    loading="eager"
  />
  <div class="overlay" aria-hidden="true"></div>
  <div class="container layout">
    <div class="copy">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          {crumbs.map((c, i) => (
            <li>
              {c.href && i < crumbs.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
            </li>
          ))}
        </ol>
      </nav>

      <p class="eyebrow">{eyebrow}</p>
      <h1>
        {before}{at >= 0 && <span class="accent">{h1Accent}</span>}{after}
      </h1>
      <p class="sub">{sub}</p>

      <ul class="bullets">
        {bullets.map((b) => (
          <li>
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="currentColor" /><path d="M7 12.5l3.2 3.2L17 9" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
            {b}
          </li>
        ))}
      </ul>

      <div class="ctas">
        <a class="btn btn-call" href={business.phoneHref}>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24 11.4 11.4 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2z"/></svg>
          {business.phoneDisplay}
        </a>
        <a class="btn btn-alt" href={ctaHref}>{ctaLabel}</a>
      </div>
    </div>

    <aside class="now-card" aria-label="Call now">
      <p class="live"><span class="dot" aria-hidden="true"></span> Crews available now</p>
      <p class="now-title">{nowTitle}</p>
      <p class="now-text">{nowText}</p>
      <a class="now-phone" href={business.phoneHref}>{business.phoneDisplay}</a>
      <p class="now-digits">{business.phoneDigits}</p>
      {reviewSummary.rating !== null && (
        <a class="rating" href={business.googleReviewsUrl} target="_blank" rel="noopener">
          <span class="stars" aria-hidden="true">★★★★★</span>
          <strong>{reviewSummary.rating.toFixed(1)}</strong> on Google
        </a>
      )}
    </aside>
  </div>
</section>

<style>
  .inner-hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-7) var(--space-8);
    background: var(--color-black);
    color: #fff;
  }
  .bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(95deg, rgba(5, 7, 13, 0.93) 0%, rgba(5, 7, 13, 0.75) 55%, rgba(10, 26, 63, 0.6) 100%);
  }
  .layout {
    position: relative;
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-7);
    align-items: center;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 var(--space-5);
    padding: 0;
    list-style: none;
    font-size: 0.9rem;
    color: var(--color-chrome);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 6px;
    opacity: 0.5;
  }
  .crumbs a {
    color: var(--color-chrome);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: #fff;
  }
  .crumbs [aria-current] {
    color: #fff;
    font-weight: 600;
  }

  .eyebrow {
    margin: 0 0 var(--space-3);
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-flame);
  }
  h1 {
    font-size: clamp(2.2rem, 4.4vw, 3.6rem);
    line-height: 1.08;
    text-wrap: balance;
    text-shadow: 0 4px 24px rgba(0, 0, 0, 0.5);
  }
  h1 .accent {
    color: var(--color-water);
    text-shadow: var(--glow-water);
  }
  .sub {
    margin: var(--space-4) 0 0;
    max-width: 58ch;
    font-size: 1.2rem;
    line-height: 1.6;
    color: #dde1e8;
  }
  .bullets {
    display: grid;
    gap: 10px;
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }
  .bullets li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 1.05rem;
  }
  .bullets svg {
    flex: none;
    color: var(--color-water);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 58px;
    padding: 0 32px;
    border-radius: var(--radius-pill);
    font-weight: var(--font-weight-button);
    font-size: 1.15rem;
    text-decoration: none;
    transition: transform 0.15s, background 0.15s;
  }
  .btn:hover {
    transform: translateY(-2px);
  }
  .btn-call {
    background: var(--color-fire);
    color: #fff;
    font-family: var(--font-heading);
    font-style: italic;
    font-stretch: var(--heading-stretch);
    font-weight: 800;
    font-size: 1.25rem;
    box-shadow: var(--glow-fire);
  }
  .btn-call:hover {
    background: var(--color-fire-dark);
  }
  .btn-alt {
    background: var(--color-water-ui);
    color: #fff;
    box-shadow: var(--glow-water);
  }
  .btn-alt:hover {
    background: var(--color-water-dark);
  }

  .now-card {
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: rgba(5, 7, 13, 0.72);
    border: 1px solid rgba(201, 206, 214, 0.25);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: inset 0 3px 0 var(--color-fire), 0 24px 48px rgba(0, 0, 0, 0.4);
    text-align: center;
  }
  .live {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    background: rgba(46, 158, 62, 0.15);
    color: #7ee08c;
    font-weight: 700;
    font-size: 0.85rem;
  }
  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #3ddc58;
    box-shadow: 0 0 0 0 rgba(61, 220, 88, 0.6);
    animation: pulse 1.8s infinite;
  }
  @keyframes pulse {
    70% { box-shadow: 0 0 0 10px rgba(61, 220, 88, 0); }
    100% { box-shadow: 0 0 0 0 rgba(61, 220, 88, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .dot { animation: none; }
  }
  .now-title {
    margin: var(--space-3) 0 4px;
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 800;
    font-size: 1.35rem;
  }
  .now-text {
    margin: 0;
    color: var(--color-chrome);
  }
  .now-phone {
    display: block;
    margin-top: var(--space-3);
    font-family: var(--font-heading);
    font-style: italic;
    font-stretch: var(--heading-stretch);
    font-weight: 900;
    font-size: 2.3rem;
    line-height: 1.1;
    color: var(--color-fire);
    text-decoration: none;
    text-shadow: var(--glow-fire);
  }
  .now-digits {
    margin: 2px 0 0;
    font-weight: 600;
    color: var(--color-chrome);
  }
  .rating {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: var(--space-4);
    color: #fff;
    text-decoration: none;
    font-size: 0.95rem;
  }
  .rating .stars {
    color: #f5b301;
    letter-spacing: 2px;
  }

  @media (max-width: 1000px) {
    .layout { grid-template-columns: 1fr; gap: var(--space-5); }
    .now-card { display: none; }
  }
  @media (max-width: 600px) {
    .inner-hero { padding-block: var(--space-5) var(--space-7); }
    .crumbs ol { margin-bottom: var(--space-4); font-size: 0.82rem; }
    .sub { font-size: 1.08rem; }
    .ctas { flex-direction: column; }
    .btn { width: 100%; }
  }
</style>
