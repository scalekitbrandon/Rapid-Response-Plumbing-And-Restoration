---
/*
  "Problems we fix" grid for service pages: icon + H3 + short text cards (white section).
  Each H3 is a long-tail variant of the page keyword (e.g. "Burst Pipe Repair").
*/
import ServiceIcon from './ServiceIcon.astro';
import type { IconName as Icon } from '../lib/icons';

interface Issue {
  title: string;
  text: string;
  icon: Icon;
}

interface Props {
  heading: string;
  intro: string;
  issues: Issue[];
}

const { heading, intro, issues } = Astro.props;
---

<section class="issues" aria-labelledby="issues-heading">
  <div class="container">
    <div class="head">
      <h2 id="issues-heading">{heading}</h2>
      <p>{intro}</p>
    </div>
    <ul class="grid">
      {issues.map((i) => (
        <li class={`card icon-${i.icon}`}>
          <span class="icon" aria-hidden="true"><ServiceIcon name={i.icon} /></span>
          <h3>{i.title}</h3>
          <p>{i.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .issues {
    background: #fff;
    padding-block: var(--space-8);
  }
  .head {
    max-width: 760px;
    margin-bottom: var(--space-6);
  }
  h2 {
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    line-height: 1.15;
    color: var(--color-fg);
    text-wrap: balance;
  }
  .head p {
    margin: var(--space-3) 0 0;
    font-size: 1.15rem;
    line-height: 1.6;
    color: #3a4356;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    padding: var(--space-5) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: #fff;
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  .card:hover {
    border-color: var(--color-water);
    box-shadow: 0 12px 28px rgba(10, 26, 63, 0.08);
    transform: translateY(-3px);
  }
  .icon {
    display: block;
    width: 52px;
    height: 52px;
    margin-bottom: var(--space-3);
    color: var(--color-water);
  }
  .icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .icon-heater .icon,
  .icon-freeze .icon,
  .icon-valve .icon {
    color: var(--color-fire);
  }
  h3 {
    font-size: 1.2rem;
    line-height: 1.2;
    color: var(--color-fg);
    text-transform: uppercase;
  }
  .card p {
    margin: var(--space-2) 0 0;
    line-height: 1.55;
    color: #3a4356;
  }

  @media (max-width: 1100px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .issues { padding-block: var(--space-7); }
    .grid { grid-template-columns: 1fr; gap: var(--space-3); }
    .card { display: grid; grid-template-columns: 44px 1fr; column-gap: var(--space-3); padding: var(--space-4); }
    .icon { width: 44px; height: 44px; grid-row: span 2; margin: 0; }
  }
</style>
